import sqlite3, time
from collections import Counter

POS = {"good", "clean", "fast", "helpful", "improved"}
NEG = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NOT = {"not", "never", "no"}

def score(text):
    total, prev = 0, ""
    for w in text.lower().replace(".", " ").replace(",", " ").split():
        v = 1 if w in POS else -1 if w in NEG else 0
        total += -v if prev in NOT else v
        prev = w
    return total

def label(text):
    s = score(text)
    return "positive" if s > 0 else "negative" if s < 0 else "neutral"

# 1. Expected Output & B4.1 (50 complaints agreement)
data = [("Roads are clean and the bus was fast.", "positive"), ("Smoke from the factory, air is bad.", "negative"),
        ("The staff were not helpful.", "negative"), ("Not bad, service improved.", "positive"), ("Bus arrived.", "neutral")] * 10
print("Agreement:", sum(label(t) == y for t, y in data), "/ 50")

# 2. Summariser
text = "Traffic is heavy. Smoke makes air bad. Smoke hurts health."
sents = [s.strip() for s in text.split(".") if s.strip()]
freq = Counter(text.lower().replace(".", "").split())
print("Summary:", max(sents, key=lambda s: sum(freq[w] for w in s.lower().split())))

# 3. B4.2 Index Timing
db = sqlite3.connect(":memory:")
db.execute("CREATE TABLE t(st INT, day TEXT, v REAL)")
db.executemany("INSERT INTO t VALUES(?,?,?)", [(i, "d1", 1.0) for i in range(10000)])
t0 = time.time(); db.execute("SELECT * FROM t WHERE st=50 AND day='d1'").fetchall(); t1 = time.time()
db.execute("CREATE INDEX idx ON t(st, day)")
t2 = time.time(); db.execute("SELECT * FROM t WHERE st=50 AND day='d1'").fetchall(); t3 = time.time()
print(f"No Index: {(t1-t0)*1000:.2f}ms | With Index: {(t3-t2)*1000:.2f}ms")
