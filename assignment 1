from decimal import Decimal

def calculate_rate(fat, snf):
    fat_steps = int((fat - Decimal("3.50")) * 10)
    snf_steps = int((snf - Decimal("8.50")) * 10)

    rate = (Decimal("32.00")
            + fat_steps * Decimal("0.45")
            + snf_steps * Decimal("0.30"))
    return rate

def bonus(litres):
    if litres > 500:
        return litres * Decimal("0.50")
    return Decimal("0.00")

fat = Decimal("4.20")
snf = Decimal("8.70")
litres = Decimal("501")

rate = calculate_rate(fat, snf)

print("Milk Rate:", rate)
print("Bonus:", bonus(litres))
